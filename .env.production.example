# TEMPLATE ONLY. Never commit your real production .env or upload it to ChatGPT.
# Put real secrets in your deploy host's secret manager or protected environment.
POSTGRES_DB=findit
POSTGRES_USER=findit
POSTGRES_PASSWORD=REPLACE_WITH_INDEPENDENT_RANDOM_DATABASE_PASSWORD
FINDIT_DATABASE_URL=postgresql+psycopg://findit:REPLACE_WITH_URL_ENCODED_DATABASE_PASSWORD@db:5432/findit
FINDIT_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
FINDIT_ALLOWED_ORIGINS=["https://findit.example.edu"]
FINDIT_TRUSTED_HOSTS=["findit.example.edu"]
FINDIT_PUBLIC_BASE_URL=https://findit.example.edu
# Public FQDN must point to this server; TCP 80/443 must reach it.
FINDIT_DOMAIN=findit.example.edu

# Shared authentication admission limits (all requests, including successes).
FINDIT_LOGIN_ATTEMPT_LIMIT=8
FINDIT_LOGIN_IP_ATTEMPT_LIMIT=40
FINDIT_REGISTRATION_ATTEMPT_LIMIT=20
FINDIT_LOGIN_ATTEMPT_WINDOW_SECONDS=300
# Evidence count per claim and total bytes per report owner/claimant.
FINDIT_MAX_CLAIM_EVIDENCE_IMAGES=5
FINDIT_MAX_USER_UPLOAD_BYTES=104857600

# Institutional authentication (exact domain, no implicit subdomains).
FINDIT_ALLOWED_EMAIL_DOMAINS=["suh.edu.in"]
FINDIT_REQUIRE_EMAIL_VERIFICATION=true
FINDIT_MAIL_FROM=FindIt <noreply@suh.edu.in>
# Configure the institution's actual SMTP relay before running preflight.
FINDIT_MAIL_BACKEND=smtp
FINDIT_SMTP_HOST=REPLACE_WITH_SMTP_HOST
FINDIT_SMTP_PORT=587
FINDIT_SMTP_SECURITY=starttls
FINDIT_SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
FINDIT_SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
# Choose an unused private subnet; only the internal Nginx proxy joins it with the API.
FINDIT_PROXY_SUBNET=172.30.90.0/28
