# FindIt Next 2.0 local development configuration.
# Copy this file to .env and replace every CHANGE_ME value.
# `./scripts/dev.ps1 setup` does that automatically on Windows/PowerShell.

COMPOSE_PROJECT_NAME=findit-next

# Published host ports
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

# PostgreSQL (development only; use managed secrets outside local development)
POSTGRES_DB=findit
POSTGRES_USER=findit
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# Application and session security
FINDIT_ENVIRONMENT=development
FINDIT_DATABASE_URL=postgresql+psycopg://findit:CHANGE_ME_POSTGRES_PASSWORD@db:5432/findit
FINDIT_SECRET_KEY=CHANGE_ME_SESSION_SECRET
FINDIT_SESSION_TTL_HOURS=168
FINDIT_COOKIE_SECURE=false

# JSON array of browser origins permitted by CORS
FINDIT_ALLOWED_ORIGINS=["http://localhost:5173"]
FINDIT_PUBLIC_BASE_URL=http://localhost:5173

# Persistent upload settings
FINDIT_MEDIA_ROOT=/data/media
FINDIT_MAX_UPLOAD_BYTES=8388608
FINDIT_MAX_REPORT_IMAGES=5

# Authentication throttling (per client address and account identifier)
FINDIT_LOGIN_ATTEMPT_LIMIT=10
FINDIT_LOGIN_ATTEMPT_WINDOW_SECONDS=60

# Keep the browser API URL empty locally so requests use Vite's same-origin proxy.
VITE_API_URL=
VITE_PROXY_TARGET=http://backend:8000


# Shared authentication admission limits (all requests, including successes).
FINDIT_LOGIN_ATTEMPT_LIMIT=8
FINDIT_LOGIN_IP_ATTEMPT_LIMIT=40
FINDIT_REGISTRATION_ATTEMPT_LIMIT=20
FINDIT_LOGIN_ATTEMPT_WINDOW_SECONDS=300
# Evidence count per claim and total bytes per report owner/claimant.
FINDIT_MAX_CLAIM_EVIDENCE_IMAGES=5
FINDIT_MAX_USER_UPLOAD_BYTES=104857600

# Institutional authentication (exact domain, no implicit subdomains).
FINDIT_ALLOWED_EMAIL_DOMAINS=["suh.edu.in"]
FINDIT_REQUIRE_EMAIL_VERIFICATION=true
FINDIT_MAIL_FROM=FindIt <noreply@suh.edu.in>
# Development/test only: mail is written as private .eml files; never publicly serve this folder.
FINDIT_MAIL_BACKEND=file
FINDIT_MAIL_DIRECTORY=/data/mail
