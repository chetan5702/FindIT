{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "target": "ES2022"
  },
  "include": [
    "vite.config.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    "e2e/**/*.ts"
  ]
}
